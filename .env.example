DATABASE_URL=postgresql://user:pass@host.neon.tech/atmos?sslmode=require
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — notifications to staff only (docs/05). No client auto-responder in v1.
RESEND_API_KEY=
# Verified sender. Must be on a domain verified in Resend or sends bounce.
ATMOS_FROM_EMAIL=Atmos <njoftime@atmos.al>
# Shared triage queue: owner submissions, and any enquiry with no assigned agent.
ATMOS_INBOX_EMAIL=info@atmos.al
# Bcc'd on every notification. Defaults to the inbox when unset.
ATMOS_ADMIN_EMAIL=
# Set to `stub` to skip sending entirely — the e2e suite sets this so a test
# run never reaches Resend. Checked before RESEND_API_KEY, so a real key in a
# local .env still gets stubbed under tests.
ATMOS_EMAIL_TRANSPORT=

DATABASE_URL=postgresql://user:pass@host.neon.tech/atmos?sslmode=require
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=

# The site's absolute base URL. Read by lib/seo.ts for canonicals, hreflang,
# JSON-LD and the links inside notification emails. Unset means localhost, so
# a deployment that forgets this publishes localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — notifications to staff only (docs/05). No client auto-responder in v1.
RESEND_API_KEY=
# Sender. `onboarding@resend.dev` is Resend's shared test sender and needs no
# domain verification, but it can only deliver to the Resend account owner's
# own address. Switch to `Atmos <noreply@atmos.al>` once atmos.al is verified.
RESEND_FROM=Atmos <onboarding@resend.dev>
# Redirect every notification here regardless of routing. Required while the
# test sender is in use, and worth keeping set on staging so a test submission
# can never email a real agent. Leave EMPTY in production.
RESEND_OVERRIDE_TO=
# Shared triage queue: owner submissions, and any enquiry with no assigned agent.
ATMOS_INBOX_EMAIL=info@atmos.al
# Bcc'd on every notification. Defaults to the inbox when unset. Ignored while
# RESEND_OVERRIDE_TO is set.
ATMOS_ADMIN_EMAIL=
# Set to `stub` to skip sending entirely — the e2e suite sets this so a test
# run never reaches Resend. Checked before RESEND_API_KEY, so a real key in a
# local .env still gets stubbed under tests.
ATMOS_EMAIL_TRANSPORT=
